# PCD connection: not set here. On the appliance, PCD_AUTH_URL, PCD_REGION, PCD_PROJECT_ID
# and PCD_PROJECT_NAME come from /etc/pcd-app/config.env (written by the PCD App Catalog);
# for local development see dev.config.env in the README. There is no PCD username or
# password anywhere: people log in with their own PCD account, and an admin authorizes
# background access once.

# Grafana / Prometheus (Prometheus is proxied through Grafana in PCD)
GRAFANA_URL=https://your-pcd-host/grafana/
GRAFANA_TOKEN=glsa_...
PROMETHEUS_URL=https://your-pcd-host/grafana/api/datasources/proxy/1

# AI backend: 'ollama' (default) or 'claude'
AI_BACKEND=ollama
AI_URL=http://localhost:11434
AI_MODEL=llama3.1:8b
AI_API_KEY=

# GitHub feedback (issues:write scope required)
GITHUB_TOKEN=
GITHUB_REPO=platform9/pcd-ops
