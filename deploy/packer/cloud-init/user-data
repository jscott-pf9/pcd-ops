#cloud-config
# Temporary credentials used only during the Packer image build.
# provision.sh locks this password at the end.
ssh_pwauth: true
chpasswd:
  list: |
    ubuntu:packer-build-temp
  expire: false
users:
  - name: ubuntu
    groups: [sudo, adm]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
