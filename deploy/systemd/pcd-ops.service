[Unit]
Description=PCD Ops
After=network.target

[Service]
Type=simple
User=pcd-ops
WorkingDirectory=/opt/pcd-ops/backend
ExecStart=/opt/pcd-ops/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
EnvironmentFile=-/opt/pcd-ops/.env
Environment="PCD_OPS_DIR=/opt/pcd-ops"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
